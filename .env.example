# ELEVENLABS_API_KEY: Required for server-side ElevenLabs German speech synthesis.
# Configure this via the Secrets panel in AI Studio. Never expose it in frontend code.
ELEVENLABS_API_KEY="MY_ELEVENLABS_API_KEY"

# SUPABASE_URL & SUPABASE_PUBLISHABLE_KEY: Required for Supabase Auth, Postgres, and Storage (`german-learning` bucket).
# Use ONLY the public/publishable key here; NEVER expose service_role or sb_secret_* keys in frontend code.
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_PUBLISHABLE_KEY="MY_SUPABASE_PUBLISHABLE_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"
