{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "typeRoots": ["../node_modules/@types"],
    "types": ["node"],
    "lib": ["ES2022"],
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": [
    "./**/*.ts",
    "../src/services/elevenLabsConstants.js",
    "../src/services/elevenLabsConstants.d.ts",
    "../src/types/index.ts",
    "../src/utils/audioHash.ts",
    "../src/data/germanCoreGlossary.js",
    "../src/data/germanCoreGlossary.d.ts",
    "../src/data/germanDictionary.ts"
  ]
}
